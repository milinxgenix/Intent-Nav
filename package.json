{
  "name": "intentnav-scfr",
  "version": "1.0.0",
  "description": "IntentNav-SCFR: Self-Adaptive Functional Capability Identity, Drift-Localized Invariant Re-Binding, Causal Transition Verification, and Risk-Gated Navigation System",
  "type": "module",
  "scripts": {
    "build": "vite build && npx esbuild src/browser/contentScript.ts --bundle --format=iife --outfile=dist/contentScript.js && cp manifest.json dist/ && cp dist/src/ui/popup.html dist/popup.html",
    "test": "vitest run test/",
    "test:unit": "vitest run test/unit",
    "test:adversarial": "vitest run test/adversarial",
    "test:properties": "vitest run test/properties",
    "benchmark": "vitest run benchmark/runner.spec.ts",
    "benchmark:run": "vitest run benchmark/runner.spec.ts",
    "serve:mocks": "node scripts/serveMocks.js",
    "test:e2e:chromium": "node scripts/runChromiumE2E.js",
    "test:e2e:chromium:neg": "node scripts/runNegativeChromiumE2E.js",
    "validate:evidence": "node scripts/validateChromiumEvidence.js",
    "validate:evidence:neg": "node scripts/validateNegativeEvidence.js"
  },
  "keywords": [
    "browser-extension",
    "adaptive-navigation",
    "invariant-closure",
    "causal-verification",
    "drift-localization",
    "risk-gating"
  ],
  "author": "IntentNav-SCFR Research Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.5.5",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^2.1.1",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.12"
  }
}

